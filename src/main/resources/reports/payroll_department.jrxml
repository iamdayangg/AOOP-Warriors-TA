                <textFieldExpression><![CDATA[$F{grossIncome}]]></textFieldExpression>
            </textField>

            <textField><reportElement x="370" y="2" width="70" height="14"/><textElement textAlignment="Center"><font size="6"/></textElement><textFieldExpression><![CDATA[$F{sssNo}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00">
