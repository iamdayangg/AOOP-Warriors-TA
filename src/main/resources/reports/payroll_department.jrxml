                <text><![CDATA[GROSS INCOME]]></text>
            </staticText>

<!-- NET PAY -->
<staticText>
    <reportElement x="895" y="0" width="53" height="32" forecolor="#FFFFFF"/>
    <textElement textAlignment="Center" verticalAlignment="Middle">
        <font size="6" isBold="true"/>
    </textElement>
    <text><![CDATA[NET PAY]]></text>
</staticText>

            <!-- Group labels (top row, span 2 sub-columns each) -->
            <staticText>
                <reportElement x="370" y="0" width="130" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6" isBold="true"/></textElement>
                <text><![CDATA[SOCIAL SECURITY SYSTEM]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="0" width="135" height="16" forecolor="#FFFFFF"/>
