                <text><![CDATA[BIR]]></text>
            </staticText>

            <!-- Divider between group row and sub-label row -->
            <line>
    <reportElement x="370" y="16" width="525" height="1" forecolor="#D2DAE8"/>
</line>

            <!-- Sub-labels (bottom row) -->
            <staticText>
                <reportElement x="370" y="17" width="70" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6"/></textElement>
                <text><![CDATA[SSS No.]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="17" width="60" height="15" forecolor="#FFFFFF"/>
