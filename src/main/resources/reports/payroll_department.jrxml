                <text><![CDATA[Withholding Tax]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- DETAIL -->
    <detail>
        <band height="18">

            <textField><reportElement x="0" y="2" width="35" height="14"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{empNo}]]></textFieldExpression></textField>
            <textField><reportElement x="35" y="2" width="105" height="14"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{empName}]]></textFieldExpression></textField>
            <textField><reportElement x="140" y="2" width="85" height="14"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{position}]]></textFieldExpression></textField>
            <textField><reportElement x="225" y="2" width="75" height="14"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{department}]]></textFieldExpression></textField>

            <textField pattern="#,##0.00">
