                <text><![CDATA[Contribution]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="17" width="70" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6"/></textElement>
                <text><![CDATA[PhilHealth No.]]></text>
            </staticText>
            <staticText>
                <reportElement x="570" y="17" width="65" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6"/></textElement>
                <text><![CDATA[Contribution]]></text>
            </staticText>
            <staticText>
                <reportElement x="635" y="17" width="70" height="15" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6"/></textElement>
                <text><![CDATA[Pag-ibig No.]]></text>
            </staticText>
            <staticText>
                <reportElement x="705" y="17" width="60" height="15" forecolor="#FFFFFF"/>
